		 <object-name>LSwindowGL</object-name>
        <object-name>CrewDoorGL</object-name>
        <object-name>BayDoorGL</object-name>
       
        <object-name>MLBglass</object-name>
        <object-name>LBglass</object-name>
        <object-name>RBglass</object-name>
      
    </effect>
	
	<animation>
  <type>select</type>
 <object-name>GL</object-name>
		<object-name>GLup</object-name>
		 <object-name>LSwindowGL</object-name>
        <object-name>CrewDoorGL</object-name>
        <object-name>BayDoorGL</object-name>
  <condition>
   <not>
   <equals>
    <property>sim/current-view/internal</property>
    <value>true</value>
   </equals>
   </not>
  </condition>
 </animation>  
	

	
	<effect>
       <inherits-from>Effects/glass</inherits-from>
        <object-name>GLin</object-name>
		<object-name>GLupin</object-name>
		 <object-name>LSwindowGLin</object-name>
        <object-name>CrewDoorGLin</object-name>
        <object-name>BayDoorGLin</object-name>
       
    </effect>
	
	<animation>
  <type>select</type>
     <object-name>GLin</object-name>
		<object-name>GLupin</object-name>
		 <object-name>LSwindowGLin</object-name>
        <object-name>CrewDoorGLin</object-name>
        <object-name>BayDoorGLin</object-name>
  <condition>

   <equals>
    <property>sim/current-view/internal</property>
    <value>true</value>
   </equals>
   
  </condition>
 </animation>	

