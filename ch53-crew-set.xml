<PropertyList>

<sim>

  <description>Sikorsky CH-53E Super Stallion Multiplayer crew</description>
  <author>Anders Gidenstam</author>
  <status>alpha</status>
  <aircraft-version>$Id$</aircraft-version>
  
  <flight-model>null</flight-model>
  
  <previews>
	  <preview>
		<type>interior</type>
		<splash type="bool">true</splash>
		<path>Splash/fgfs-20240319211723.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/fgfs-20240319200044.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/fgfs-20240319211733.png</path>
	  </preview>
	  
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/fgfs-20240319212020.png</path>
	  </preview>
	  <preview>
		<type>exterior</type>
		<splash type="bool">true</splash>
		<path>Splash/fgfs-20240319213937.png</path>
	  </preview>
	   
	</previews>
	
	 <systems>
		  
   
	      <autopilot n="102">
                <path>Aircraft/ch53e/System/glass-rain.xml</path>
            </autopilot>
	
    </systems> 

  <presets>
   <onground type="bool">false</onground>
   <altitude-agl-ft type="double">30.0</altitude-agl-ft>
  </presets>

  <!-- 3d model -->
  <model>
   <path>Aircraft/ch53e/Models/CH53E-crew.xml</path>
    <ch53e>
	<!--  For switching between shiny and non shiny paint in HDR mode -->
	<hdr>true</hdr>
	<als>false</als>
	</ch53e>
  </model>

	<rendering>
    <refl_correction type="string">-0.45</refl_correction>
    </rendering>

 	
		
		
 		<sound>
		  <path>Aircraft/ch53e/Sounds/ch53e-sound.xml</path>
		</sound>
		
	
		
		
  <!-- Aircraft specific help. -->
  <!-- help include="help.xml"/ -->

     

  <menubar>
   <default>
    <menu n="100">
     <label>CH-53e</label>
     <item>
      <label>Select MP-pilot</label>
      <binding>
       <command>nasal</command>
       <script>
        dual_control_tools.
          copilot_dialog.show(aircraft_dual_control.pilot_type);
       </script>
      </binding>
     </item>
    </menu>
   </default>
  </menubar>
  
  
  <chase-distance-m type="double" archive="y">-30.0</chase-distance-m>

 <view n="0">
    <name> Pilot Seat View</name>
	<type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
      <pitch-offset-deg>-5</pitch-offset-deg>
     <x-offset-m archive="y">  -0.68 </x-offset-m> <!--right-->
      <y-offset-m archive="y">  2.1 </y-offset-m> <!--up-->
      <z-offset-m archive="y"> -6.3 </z-offset-m> <!--back-->
      <default-field-of-view-deg>85</default-field-of-view-deg>
      <dynamic-view type="bool">true</dynamic-view>
    </config>
  </view>

  <view n="101">
    <name>Bay View</name>
    <internal archive="y">true</internal>
    <type>lookfrom</type>
    <config>
      <from-model type="bool">true</from-model>
      <ground-level-nearplane-m type="double">0.5f</ground-level-nearplane-m>
      <x-offset-m archive="y" type="double"> 0.3 </x-offset-m> <!--Right-->
      <y-offset-m archive="y" type="double"> 1.7 </y-offset-m> <!--Up-->
      <z-offset-m archive="y" type="double"> 5.3 </z-offset-m> <!--Back-->
      <pitch-offset-deg>-10</pitch-offset-deg>
      <default-field-of-view-deg>60</default-field-of-view-deg>
      <dynamic-view type="bool">true</dynamic-view>
    </config>
  </view>

  <view n="102">
    <name>Tail Camera View</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
      <default-field-of-view-deg type="double">30</default-field-of-view-deg>
      <pitch-offset-deg>-5</pitch-offset-deg>
      <x-offset-m archive="y">  0.000 </x-offset-m> <!--Right-->
      <y-offset-m archive="y">  5 </y-offset-m> <!--Up-->
      <z-offset-m archive="y"> 16.0 </z-offset-m> <!--Back-->
    </config>
  </view>
  
  
  <view n="109">
    <name>Hook View</name>
    <type>lookfrom</type>
    <internal archive="y">true</internal>
    <config>
      <from-model type="bool">true</from-model>
      <from-model-idx type="int">0</from-model-idx>
      <ground-level-nearplane-m type="double">0.01f</ground-level-nearplane-m>
           <pitch-offset-deg>-90</pitch-offset-deg>
      <x-offset-m archive="y">  0.00 </x-offset-m> <!--Right-->
      <y-offset-m archive="y">  -1.2 </y-offset-m> <!--Up-->
      <z-offset-m archive="y">0.7 </z-offset-m> <!--Back-->
	  
      <default-field-of-view-deg>95</default-field-of-view-deg>
    </config>
  </view>

 
  
